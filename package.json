{
  "name": "@didmail/server",
  "version": "0.1.0",
  "scripts": {
    "start": "arc blocklet run blocklet/dist",
    "build": "arc blocklet build blocklet",
    "type-check": "tsc --noEmit",
    "test": "jest --runInBand",
    "lint": "tsc --noEmit && pnpm type-check:runtime && eslint tests/unit tests/support --ext .ts && pnpm lint:ui && pnpm lint:runtime",
    "arc:check": "arc dsl validate blocklet && arc blocklet check blocklet --profile basic",
    "test:smoke": "node scripts/smoke.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "audit:distribution": "node scripts/audit-distribution.mjs",
    "audit:distribution:update": "node scripts/audit-distribution.mjs --write",
    "chain:status": "node scripts/chain-status.mjs",
    "test:browser": "node scripts/browser-render.mjs",
    "test:browser:help": "node scripts/browser-help.mjs",
    "test:browser:admin": "node scripts/browser-admin.mjs",
    "lint:ui": "eslint --no-eslintrc --config ui/.eslintrc.cjs ui/*.js",
    "test:ui": "node --test tests/ui/*.test.mjs",
    "test:browser:ui": "node scripts/browser-ui.mjs",
    "test:browser:policy": "node scripts/browser-mail-policy.mjs",
    "test:browser:accounts": "node scripts/build-business-tests.mjs && cross-env DIDMAIL_ACCOUNT_BROWSER_TEST=1 node --test --test-name-pattern=\"native authorization page\" tests/business/account-links.test.mjs",
    "type-check:runtime": "tsc -p tsconfig.runtime.json",
    "test:business": "node scripts/build-business-tests.mjs && node --test --test-concurrency=1 tests/business/*.test.mjs",
    "test:business:standalone": "node scripts/test-business-standalone.mjs",
    "test:arc": "cross-env DIDMAIL_ARC_HTTP_TEST=1 node --test scripts/arc-http-package-live.test.mjs",
    "migration:export:legacy": "node scripts/migration/export-legacy-data.mjs",
    "legacy:wallet:setup": "node scripts/legacy-wallet-setup.mjs",
    "legacy:sqlite:import": "node scripts/migration/import-legacy-sqlite.mjs",
    "lint:runtime": "node scripts/lint-runtime.mjs"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@arcblock/did": "^1.19.12",
    "@arcblock/did-util": "^1.19.12",
    "@arcblock/vc": "^1.19.12",
    "@didmail/ocap-message-cbor": "npm:@ocap/message@1.30.24",
    "@didmail/protocol": "git+https://github.com/didmail-org/protocol.git#20c21de1fe89397bf4be35435d7a8a3bbc0ee59a",
    "@ocap/asset": "^1.19.12",
    "@ocap/client": "1.19.15",
    "@ocap/mcrypto": "^1.30.24",
    "@ocap/util": "^1.19.12",
    "@ocap/wallet": "^1.19.12",
    "@tanstack/query-core": "5.104.5",
    "axios": "^1.21.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "country-flag-icons": "^1.5.18",
    "dotenv": "^16.4.7",
    "dotenv-flow": "^4.1.0",
    "ethers": "^6.17.0",
    "express": "^4.22.3",
    "express-async-errors": "^3.1.1",
    "express-cache-headers": "^0.1.4",
    "graphql": "^16.14.2",
    "https-proxy-agent": "^7.0.6",
    "multer": "2.5.0",
    "node-fetch": "3.3.2",
    "qrcode-generator": "1.4.4",
    "reflect-metadata": "^0.2.2",
    "sequelize": "^6.37.8",
    "sequelize-typescript": "^2.1.6",
    "sqlite3": "^6.0.1",
    "svgo": "^3.3.5"
  },
  "devDependencies": {
    "@arcblock/eslint-config": "^0.3.3",
    "@arcblock/eslint-config-ts": "^0.3.3",
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@jest/globals": "^29.7.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/dotenv-flow": "^3.3.3",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.7",
    "@types/validator": "^13.12.2",
    "babel-jest": "29.7.0",
    "cross-env": "^7.0.3",
    "cross-fetch": "4.1.0",
    "debug": "^4.4.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.1",
    "import-sort-style-module": "^6.0.0",
    "jest": "^29.7.0",
    "miniflare": "5.20261019.2-beta",
    "playwright-core": "^1.64.1",
    "prettier": "^3.5.2",
    "prettier-plugin-import-sort": "^0.0.7",
    "rimraf": "^5.0.10",
    "ts-jest": "^29.2.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2",
    "ws": "8.21.0"
  },
  "importSort": {
    ".js, .jsx, .mjs": {
      "parser": "babylon",
      "style": "module"
    },
    ".ts, .tsx": {
      "style": "module",
      "parser": "typescript"
    }
  },
  "private": true,
  "engines": {
    "node": ">=24.14.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/didmail-org/server.git"
  },
  "packageManager": "pnpm@12.11.2",
  "license": "Apache-2.0"
}
