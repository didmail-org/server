{
  "extends": "./tsconfig",
  "compilerOptions": {
    "outDir": "api/dist",
    "noEmit": false,
    "noEmitOnError": true,
    "types": [
      "jest"
    ],
    "rootDir": "api/src"
  },
  "include": [
    "api/*.d.ts",
    "api/src",
    "api/business.d.ts"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/__tests__/**"
  ]
}
