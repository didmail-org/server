{
  "ts-node": {
    "files": true,
    "compilerOptions": {
      "module": "Node16"
    }
  },
  "compilerOptions": {
    "types": [
      "jest",
      "node"
    ],
    "target": "ES2022",
    "module": "commonjs",
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "useUnknownInCatchVariables": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "tests/unit/**/*.ts",
    "tests/support/**/*.ts",
    "blocklet/providers/didmail-http/source/types/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "artifacts",
    "blocklet/dist"
  ]
}
