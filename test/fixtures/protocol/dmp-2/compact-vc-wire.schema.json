{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://didmail.example/schemas/dmp-2/compact-vc-wire",
  "title": "DMP/2 lossless ArcBlock VC transport tuple",
  "type": "object",
  "required": [
    "dmp2vc"
  ],
  "additionalProperties": false,
  "properties": {
    "dmp2vc": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "prefixItems": [
        {
          "const": 1
        },
        {
          "type": "string",
          "pattern": "^z[1-9A-HJ-NP-Za-km-z]{20,64}$"
        },
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{22}$"
        },
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        {
          "type": "string",
          "format": "uri",
          "maxLength": 64
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      ]
    }
  },
  "$comment": "Retired profile: compatibility-test artifact only. See README.md; do not enable ordinary/chain-VC delivery."
}
